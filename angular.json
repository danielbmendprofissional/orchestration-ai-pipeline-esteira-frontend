{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "esteira-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "est",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "preview": {
              "fileReplacements": [
                {
                  "replace": "src/app/core/auth/auth-api.service.ts",
                  "with": "src/app/core/auth/auth-api.service.preview.ts"
                },
                {
                  "replace": "src/app/features/aplicacoes/aplicacoes-api.service.ts",
                  "with": "src/app/features/aplicacoes/aplicacoes-api.service.preview.ts"
                },
                {
                  "replace": "src/app/features/fatias/fatias-api.service.ts",
                  "with": "src/app/features/fatias/fatias-api.service.preview.ts"
                },
                {
                  "replace": "src/app/core/tempo-real/tempo-real.service.ts",
                  "with": "src/app/core/tempo-real/tempo-real.service.preview.ts"
                },
                {
                  "replace": "src/app/features/fatias/components/tempo-real-dev.component.ts",
                  "with": "src/app/features/fatias/components/tempo-real-dev.component.preview.ts"
                },
                {
                  "replace": "src/app/features/entregas/entregas-api.service.ts",
                  "with": "src/app/features/entregas/entregas-api.service.preview.ts"
                },
                {
                  "replace": "src/app/features/entregas/components/tempo-real-dev.component.ts",
                  "with": "src/app/features/entregas/components/tempo-real-dev.component.preview.ts"
                }
              ],
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "esteira-frontend:build:production"
            },
            "development": {
              "buildTarget": "esteira-frontend:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
